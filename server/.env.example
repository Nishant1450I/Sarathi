# ==============================================================================
# SARATHI BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your environment.
# Never commit real credentials, production secrets, or JWT keys.
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0

# Environment: 'development' or 'production'
NODE_ENV=development

# Application Mode: 'demo' (for local jury presentations) or 'production'
APP_MODE=demo

# Enable demo-session endpoints (MUST be false in production)
ENABLE_DEMO_AUTH=true

# JWT Signing Secret (MUST be a strong, cryptographically random secret in production)
JWT_SECRET=your-secure-random-jwt-secret-here
JWT_EXPIRES_IN=7d

# Permitted CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# AI PROVIDER CONFIGURATION (Server-side Only)
# To enable live AI generative responses, provide a Gemini API key or OpenAI key.
# If omitted, Sarathi runs in high-fidelity Local Knowledge Engine mode.
# Never expose these keys to the client or frontend.
# ==============================================================================
# Google Gemini API (Recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

